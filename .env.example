# OpenRouter key (image model: openai/gpt-5.4-image-2 by default; override with IMAGE_MODEL)
OPENROUTER_API_KEY=
# Meta Page access token with instagram_content_publish (non-expiring Page token)
META_ACCESS_TOKEN=
# Instagram professional account ID linked to the Page
INSTAGRAM_USER_ID=
# Shared token for the feed relay Worker (Worker secret RELAY_TOKEN, same value)
FEED_RELAY_TOKEN=
# Ad-hoc Stories (cli.mjs custom): S3 bucket + its CloudFront URL; uploads use the aws CLI credentials
STORIES_S3_BUCKET=
STORIES_CDN_BASE=
